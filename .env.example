# PostgreSQL connection string used by Drizzle and the app. This default is for local dev
# (docker-compose.dev.yml). Production on the shared server uses a different value pointing at
# that server's shared PostgreSQL instance — see docs/deployment-shared-server.md — set directly
# in the server's own .env file, never committed here.
DATABASE_URL=postgresql://app:app@localhost:5432/aydin_autoglas

# HS256 signing secret for admin JWT sessions (generate a long random string)
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Node environment
NODE_ENV=development

# SMTP (Phase 6)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Cloudflare Turnstile (Phase 6/9, toggled from admin settings)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: how many days of backups scripts/backup.sh keeps before pruning (Phase 10)
BACKUP_RETENTION_DAYS=14

# Optional: an rclone remote:path to also upload each backup to off-server storage
# (e.g. "s3:my-bucket/aydin-autoglas-backups" or "b2:my-bucket/backups"). Requires `rclone`
# installed and configured (`rclone config`) on the host running scripts/backup.sh. Leave blank
# to keep backups local-only (the previous, still-supported default).
BACKUP_REMOTE=
