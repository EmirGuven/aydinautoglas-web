# Uygulama
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Admin paneli JWT secret'i (uzun ve guclu bir deger kullanin)
ADMIN_JWT_SECRET=change_me_in_production_use_strong_secret

# Site URL (public, client tarafinda da kullanilir)
NUXT_PUBLIC_SITE_URL=https://www.aydinautoglas.de

# Cloudflare Turnstile (bot korumasi)
TURNSTILE_SECRET_KEY=0x4AAAAAAFH2KMdmJQZ7y5Y8XYINlX789Pk
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFH2KPksZkUVgClo

# Dosya yuklemeleri icin dizin (container icinde)
UPLOADS_DIR=/app/public/uploads

# docker-compose.yml icin host uzerindeki kalici veri dizini (uploads)
# Deploy'lar arasinda sabit kalmali, degistirilmemelidir.
APP_UPLOADS_DIR=/data/aydin-autoglas-web/uploads

# PostgreSQL baglanti adresi (docker'da calisan postgre servisine gore doldurun)
# Format: postgresql://KULLANICI_ADI:SIFRE@HOST:PORT/VERITABANI_ADI
# - HOST: postgres container'i ayni docker network'teyse container adi (orn. "postgres"),
#         degilse sunucunun IP'si / "host.docker.internal" olabilir.
# - Container'i bu network'e almayi unutmayin (bkz. docker-compose.yml networks bolumu).
DATABASE_URL=postgresql://aydin_autoglas:CHANGE_ME_STRONG_PASSWORD@postgres:5432/aydin_autoglas
