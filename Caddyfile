{
	# Contact address for Let's Encrypt certificate expiry notices.
	email admin@example.com
}

# Replace with the real domain before going live — see docs/deployment.md.
example.com, www.example.com {
	encode zstd gzip

	# Never proxy the uploads path to the app for writes; reads go through Nitro's own
	# path-traversal-safe route (server/routes/uploads/[...path].get.ts) same as any other path.
	reverse_proxy app:3000

	header {
		# Caddy already terminates TLS and sets HSTS via `encode`/auto-HTTPS, but the app's own
		# Strict-Transport-Security header (nuxt.config.ts routeRules) still applies here too —
		# no duplicate needed. Only add headers Caddy doesn't already cover.
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
